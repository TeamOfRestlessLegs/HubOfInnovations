# Skopiuj ten plik jako .env.local i uzupełnij (plik .env.local nie trafia do gita).

# Client ID z Google Cloud Console (instrukcja w README → "Logowanie przez Google")
VITE_GOOGLE_CLIENT_ID=

# Adres backendu. Puste = tryb demo: logowanie bez weryfikacji na serwerze.
# VITE_API_URL=http://localhost:8080

# Wyszukiwarka rozwiązań (POST { query, limit }). Puste = tryb demo z przykładową odpowiedzią.
# VITE_SEARCH_URL=http://localhost:8080/api/search
